# 超市货物管理系统 - 支付配置

# 微信支付配置
# 申请地址: https://pay.weixin.qq.com/
WECHAT_MCHID=your_wechat_merchant_id
WECHAT_APPID=your_wechat_app_id
WECHAT_APIV3_KEY=your_wechat_apiv3_key
WECHAT_CERT_PATH=./certs/apiclient_cert.pem
WECHAT_KEY_PATH=./certs/apiclient_key.pem

# 支付宝配置
# 申请地址: https://b.alipay.com/
ALIPAY_APPID=your_alipay_app_id
ALIPAY_PRIVATE_KEY=your_alipay_private_key
ALIPAY_PUBLIC_KEY=alipay_public_key
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# 支付模式
# development: 模拟支付（默认）
# production: 真实支付
PAYMENT_MODE=development
